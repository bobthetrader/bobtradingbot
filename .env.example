# Kraken exchange credentials
KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_API_SECRET=your_kraken_api_secret_here

# OpenAI — used for GPT-4o-mini market sentiment analysis
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter — used to access Nous Hermes strategy reasoning model
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Sharpe.ai — institutional derivatives data (funding rates, insider selling, news)
# Get key at: https://sharpe.ai
SHARPE_API_KEY=sk_live_your_key_here

# Railway monitoring — your Railway public dashboard URL
# Used by monitor_railway.py to detect outages and alert via Telegram
RAILWAY_URL=https://your-service.railway.app

# AI Trade Desk — Claude Code CLI OAuth token from the Claude MAX SUBSCRIPTION
# (fixed monthly cost, no metered API billing). Generate on a machine where
# Claude Code is logged in:  claude setup-token
# Without this the bot silently runs rules-only (agent falls back).
CLAUDE_CODE_OAUTH_TOKEN=your_claude_code_oauth_token_here
